# Copy to .env.local for local testing, and add the same names in Netlify:
# Site configuration > Environment variables. Never commit real values.

# Email for the "Book a visit" form (https://resend.com, free tier).
# Without this key the form shows "please WhatsApp us" in production.
RESEND_API_KEY=
# After verifying taskapac.com in Resend, for example: PAC website <enquiries@taskapac.com>
RESEND_FROM=
# Where visit requests go. Defaults to amypac2008@gmail.com when empty.
ENQUIRY_TO=

# Optional spam check (https://www.cloudflare.com/products/turnstile/, free).
# Set both, or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
